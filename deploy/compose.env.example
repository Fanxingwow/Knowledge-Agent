# Copy this file outside source control, replace every change-me value, then run:
# docker compose --env-file <your-env-file> up --build -d
#
# Credentials embedded in MongoDB/Redis URLs must remain URL-safe or be percent-encoded.

COMPOSE_PROJECT_NAME=knowledge-agent

# Published host ports. Dependency ports default to loopback-only.
API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_PORT=27017
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_BIND_ADDRESS=127.0.0.1
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090

# Reproducible image inputs.
PYTHON_VERSION=3.12.10
UV_VERSION=0.9.26
DEBIAN_MIRROR=https://mirrors.cloud.tencent.com
APP_UID=10001
APP_GID=10001
API_IMAGE=knowledge-agent:local
MONGO_IMAGE=mongo:7.0.37-jammy
REDIS_IMAGE=redis:7.4.2-alpine
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-05-24T09-08-49Z
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MILVUS_IMAGE=milvusdb/milvus:v2.6.19
ALPINE_IMAGE=alpine:3.21.3
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1-distroless

# MongoDB single-node replica set. Use URL-safe credentials.
MONGO_REPLICA_SET_NAME=rs0
MONGO_REPLICA_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGO_APP_DATABASE=knowledge_base
MONGO_APP_USERNAME=knowledge_agent
MONGO_APP_PASSWORD=change-me-mongo-app

# Redis authentication and SSE key derivation.
REDIS_PASSWORD=change-me-redis-password
REDIS_CHAT_KEY_HMAC_SECRET=change-me-redis-hmac-secret-at-least-32-bytes
METRICS_AUTH_TOKEN=change-me-metrics-auth-token-at-least-32-bytes

# Shared MinIO instance for application objects and Milvus.
MINIO_ROOT_USER=knowledge-agent-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_APP_BUCKET=knowledge-agent-files
MINIO_MILVUS_BUCKET=a-bucket
MINIO_APP_ACCESS_KEY=knowledge-agent-app
MINIO_APP_SECRET_KEY=change-me-minio-app-secret
MINIO_MILVUS_ACCESS_KEY=knowledge-agent-milvus
MINIO_MILVUS_SECRET_KEY=change-me-minio-milvus-secret

# Application capabilities. Search/import require a real model at BGE_M3_HOST_PATH.
APP_ENV=development
API_CORS_ORIGINS=http://127.0.0.1:8000
AUTH_MODE=disabled
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_OIDC_CLIENT_ID=
AUTH_JWKS_URL=
AUTH_PUBLIC_KEY=
AUTH_ALGORITHMS=RS256
AUTH_DEV_TENANT_ID=local-dev
IMPORT_ENABLED=false
SEARCH_ENABLED=false
CHAT_ENABLED=true
CHAT_SSE_BROKER=redis
IMPORT_REPOSITORY=mongo
IMPORT_REQUIRE_IDEMPOTENCY_KEY=true
IMPORT_WORKER_ENABLED=true
MONGO_REQUIRE_REPLICA_SET=true
MILVUS_ALLOW_SCHEMA_CREATE=true

# Local model and optional external AI services.
BGE_M3_HOST_PATH=./deploy/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_DEFAULT_MODEL=
VL_MODEL=

# Private MinerU adapter. Generate MINERU_GATEWAY_AUTH_TOKEN independently;
# MINERU_UPSTREAM_API_TOKEN is the cloud token created at mineru.net.
MINERU_GATEWAY_AUTH_TOKEN=change-me-mineru-gateway-auth-token-at-least-32-bytes
MINERU_UPSTREAM_API_TOKEN=change-me-mineru-cloud-api-token
MINERU_UPSTREAM_BASE_URL=https://mineru.net/api/v4
MINERU_UPSTREAM_MODEL_VERSION=vlm
MINERU_BASE_URL=http://mineru-gateway:8080
MINERU_GATEWAY_TOTAL_TIMEOUT_SECONDS=540
MINERU_GATEWAY_MAX_CONCURRENCY=2
MINERU_GATEWAY_ALLOWED_DOWNLOAD_HOSTS=.aliyuncs.com,.openxlab.org.cn,mineru.net

# Structured container logs.
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_JSON=true
LOG_DIAGNOSE=false
METRICS_ENABLED=true
PROMETHEUS_RETENTION=15d
