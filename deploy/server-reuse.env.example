# Server deployment that reuses MinIO and Milvus on the Docker host.
# Copy to deploy/server-reuse.env, replace every change-me value, then chmod 600.
# This development template intentionally uses HTTP MinIO and disabled auth.
# Do not expose the API publicly without TLS, JWT authentication, and a reverse proxy.

COMPOSE_PROJECT_NAME=knowledge-agent-server

# Attu already owns host port 8000. Keep the API loopback-only by default.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8010
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8081

# Reproducible image inputs.
PYTHON_VERSION=3.12.10
UV_VERSION=0.9.26
DEBIAN_MIRROR=https://mirrors.cloud.tencent.com
APP_UID=10001
APP_GID=10001
API_IMAGE=knowledge-agent:server
MONGO_IMAGE=mongo:7.0.37-jammy
REDIS_IMAGE=redis:7.4.2-alpine
ALPINE_IMAGE=alpine:3.21.3
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1-distroless
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0
KEYCLOAK_POSTGRES_IMAGE=postgres:17.6-alpine

# Keycloak is loopback-only. Publish both public URLs with HTTPS through a
# reverse proxy before switching APP_ENV to production.
CONSOLE_PUBLIC_ORIGIN=https://agent.example.com
KEYCLOAK_PUBLIC_URL=https://auth.agent.example.com
KEYCLOAK_REALM=enterprise-knowledge
KEYCLOAK_CLIENT_ID=enterprise-knowledge-console
AUTH_TENANT_ID=enterprise-default
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-database-password

# Optional verified self-registration. Keep disabled until every SMTP value is
# replaced. Keycloak sends a verification link, then lets the user set a password.
KEYCLOAK_REGISTRATION_ENABLED=false
KEYCLOAK_EMAIL_VERIFICATION_LIFESPAN_SECONDS=900
KEYCLOAK_SMTP_HOST=smtp.example.com
KEYCLOAK_SMTP_PORT=465
KEYCLOAK_SMTP_FROM=no-reply@example.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=企业智能知识库问答
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=no-reply@example.com
KEYCLOAK_SMTP_PASSWORD=change-me-smtp-authorization-code
KEYCLOAK_SMTP_SSL=true
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_ALLOW_UTF8=false

# Project-owned MongoDB single-node replica set. Credentials must be URL-safe.
MONGO_REPLICA_SET_NAME=rs0
MONGO_REPLICA_KEY=changeMeMongoReplicaKey0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGO_APP_DATABASE=knowledge_base
MONGO_APP_USERNAME=knowledge_agent
MONGO_APP_PASSWORD=change-me-mongo-app
MONGO_REQUIRE_REPLICA_SET=true

# Project-owned Redis. Neither MongoDB nor Redis is published to the host.
REDIS_PASSWORD=change-me-redis-password
REDIS_CHAT_KEY_HMAC_SECRET=change-me-redis-hmac-secret-at-least-32-bytes
REDIS_KEY_PREFIX=knowledge-agent:chat:v1
METRICS_AUTH_TOKEN=change-me-metrics-auth-token-at-least-32-bytes

# Existing host MinIO. The bucket must exist and must not allow anonymous access.
# MINIO_ENDPOINT has no http:// or https:// scheme.
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=change-me-minio-app-access-key
MINIO_SECRET_KEY=change-me-minio-app-secret-key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_SECURE=false

# Existing host Milvus. Use project-owned collection names to avoid altering
# collections managed by RAGFlow or other applications.
MILVUS_URL=http://host.docker.internal:19530
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
CHUNKS_COLLECTION=knowledge_agent_kb_chunks_v2
ITEM_NAME_COLLECTION=knowledge_agent_kb_item_names_v2
IMPORT_PIPELINE_VERSION=bge-m3.v1
MILVUS_ALLOW_SCHEMA_CREATE=true

# Keycloak OIDC login. Each user receives a unique JWT subject, while all users
# in this realm share AUTH_TENANT_ID and therefore the same enterprise corpus.
APP_ENV=development
API_CORS_ORIGINS=https://agent.example.com
AUTH_MODE=jwt
AUTH_ISSUER=https://auth.agent.example.com/realms/enterprise-knowledge
AUTH_AUDIENCE=enterprise-knowledge-console
AUTH_OIDC_CLIENT_ID=enterprise-knowledge-console
AUTH_JWKS_URL=http://keycloak:8080/realms/enterprise-knowledge/protocol/openid-connect/certs
AUTH_PUBLIC_KEY=
AUTH_ALGORITHMS=RS256
AUTH_DEV_TENANT_ID=local-dev
IMPORT_ENABLED=false
SEARCH_ENABLED=false
CHAT_ENABLED=true
CHAT_SSE_BROKER=redis
IMPORT_REPOSITORY=mongo
IMPORT_REQUIRE_IDEMPOTENCY_KEY=true
IMPORT_WORKER_ENABLED=true

# Search/import require a real BGE-M3 model at this host path.
BGE_M3_HOST_PATH=./deploy/models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false

# Used only with compose.gpu.yaml. cu126, cu128 and cu130 are supported.
PYTORCH_GPU_VARIANT=cu130
GPU_BGE_DEVICE=cuda:0
GPU_BGE_FP16=true
GPU_BGE_RERANKER_DEVICE=cuda:0
GPU_BGE_RERANKER_FP16=true
MODELSCOPE_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Required for streamed Agent answers in /console (imports/search remain available without it).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_DEFAULT_MODEL=
VL_MODEL=

# Private MinerU adapter. Generate MINERU_GATEWAY_AUTH_TOKEN independently;
# MINERU_UPSTREAM_API_TOKEN is the cloud token created at mineru.net.
MINERU_GATEWAY_AUTH_TOKEN=change-me-mineru-gateway-auth-token-at-least-32-bytes
MINERU_UPSTREAM_API_TOKEN=change-me-mineru-cloud-api-token
MINERU_UPSTREAM_BASE_URL=https://mineru.net/api/v4
MINERU_UPSTREAM_MODEL_VERSION=vlm
MINERU_BASE_URL=http://mineru-gateway:8080
MINERU_GATEWAY_TOTAL_TIMEOUT_SECONDS=540
MINERU_GATEWAY_MAX_CONCURRENCY=2
MINERU_GATEWAY_ALLOWED_DOWNLOAD_HOSTS=.aliyuncs.com,.openxlab.org.cn,mineru.net

# Structured logs and metrics.
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_JSON=true
LOG_DIAGNOSE=false
METRICS_ENABLED=true
PROMETHEUS_RETENTION=15d
